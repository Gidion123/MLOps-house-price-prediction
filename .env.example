# =============================================================================
# .env.example — TEMPLATE. File ini AMAN masuk Git karena isinya contoh saja.
#
# Cara pakai:
#     cp .env.example .env
# lalu isi .env dengan nilai aslimu. File .env TIDAK PERNAH masuk Git
# (sudah dikunci di .gitignore).
#
# Kenapa repot? GitHub punya bot yang memindai commit mencari API key, dan
# mereka menemukannya dalam hitungan menit (slide 28).
# Di project ini belum ada rahasia sungguhan, tapi polanya dipasang dari awal —
# karena rahasia pertama selalu datang belakangan, saat kita sudah lupa.
# =============================================================================

# ---- MLflow ----
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=house-price-prediction
MLFLOW_MODEL_NAME=house-price-regressor

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Dari mana API memuat model: "registry" | "file" | "auto"
# Di dalam container Docker nanti diisi "file".
MODEL_SOURCE=auto
# Berapa detik sekali API mengecek apakah @champion berganti.
# 0 = mati. 60 = wajar untuk produksi. 5-10 enak untuk demo.
MODEL_CHECK_INTERVAL_SECONDS=0


# ---- Token endpoint admin ----
# Mengunci POST /admin/reload (muat ulang model tanpa restart container).
# DIBIARKAN KOSONG = endpoint-nya MATI, bukan terbuka. Isi hanya kalau memang
# dibutuhkan, dengan token acak panjang. Jangan pernah ditulis di config.yaml.
# ADMIN_API_TOKEN=ganti-dengan-token-acak-yang-panjang

# ---- Kredensial Grafana (dibaca docker compose saat `up`) ----
# Compose membaca .env HANYA untuk substitusi ${VAR}; file ini tidak pernah
# ikut masuk ke dalam image. Ganti password-nya sebelum dipakai di mana pun
# selain laptop sendiri.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
