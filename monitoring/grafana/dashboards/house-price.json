          "decimals": 3,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (hasil) (rate(house_price_prediksi_total[5m]))",
          "refId": "A",
          "legendFormat": "{{hasil}}"
