    {
      "id": 9,
      "type": "bargauge",
      "title": "PSI per fitur (10 tertinggi)",
      "description": "Population Stability Index terhadap data latih. Ambang lazim industri: di bawah 0.10 stabil, 0.10-0.25 sedang, di atas 0.25 besar. Ini aturan jempol, bukan teorema — selalu dipasangkan dengan p-value uji statistik.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, house_price_drift_psi)",
          "refId": "A",
          "legendFormat": "{{fitur}}"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "minVizHeight": 14,
        "minVizWidth": 8,
        "valueMode": "color"
      }
    },
